/// This is an internal config. It should not be shipped anywhere during `make install`
#cmakedefine HAVE_EXECINFO_H
#cmakedefine HAVE_CXXABI_H
#cmakedefine HAVE_GLIBC_BACKTRACE

#cmakedefine HAVE_IFADDRS_H

#cmakedefine HAVE_EPOLL
#cmakedefine HAVE_POLL

#cmakedefine HAVE_NETLINK
#cmakedefine MINIROS_USE_NETLINK

#cmakedefine MINIROS_USE_LIBSYSTEMD
#cmakedefine HAVE_LIBSYSTEMD

#define MINIROS_GIT_COMMIT "@MINIROS_GIT_COMMIT@"
#define MINIROS_GIT_BRANCH "@MINIROS_GIT_BRANCH@"
#define MINIROS_BINARY_VERSION_STRING "@miniros_VERSION@"
