[Unit]
Description=MiniROS master unit
# Loopback is enough to bind XML-RPC. Do not wait for DHCP, VPN, or
# network-online (late NICs such as eno1 / ham0 retry via netlink).
After=network-pre.target
Before=network-online.target

[Service]
Type=notify
Environment=ROS_MASTER_URI=http://localhost:11311
Environment=MINIROS_CRASH_LOG=%L/miniroscore/miniroscore.crash
RuntimeDirectory=miniroscore
LogsDirectory=miniroscore
WorkingDirectory=%L/miniroscore
ExecStart=@CMAKE_INSTALL_PREFIX@/bin/miniroscore --dir=%/miniroscore
# Start timeout: abort (SIGABRT) so handleCrashes() writes a stack and the
# kernel/systemd-coredump stores a core. `coredumpctl dump miniroscore`.
TimeoutStartSec=10
TimeoutStopSec=5
TimeoutStartFailureMode=abort
# Allow harvesting core dumps
LimitCORE=infinity
Slice=miniros-low.slice

[Install]
WantedBy=multi-user.target
